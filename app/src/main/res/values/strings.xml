<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">CameraShit</string>
    <string name="toggle_label">카메라 셔터음 끄기</string>
    <string name="status_silent">셔터음이 꺼져 있습니다.</string>
    <string name="status_normal">셔터음이 켜져 있습니다.</string>
    <string name="status_unsupported">이 기기는 지원하지 않습니다(삼성 갤럭시 전용).</string>

    <string name="step1_title">1/3  개발자 옵션 켜기</string>
    <string name="step1_guide">처음 한 번만 설정하면 됩니다. PC나 케이블은 필요 없습니다.\n\n설정 → 휴대전화 정보 → 소프트웨어 정보 → \'빌드번호\'를 7번 연속으로 누르세요. 화면 잠금(PIN/패턴)을 물으면 입력합니다.\n\n완료하고 이 앱으로 돌아오면 다음 단계로 자동으로 넘어갑니다.</string>
    <string name="step1_button">휴대전화 정보 열기</string>
    <string name="step2_title">2/3  무선 디버깅 켜기</string>
    <string name="step2_guide">Wi-Fi에 연결된 상태에서 \'무선 디버깅\'을 켜고, 허용 팝업이 뜨면 \'허용\'을 누르세요.\n\n켠 뒤 이 앱으로 돌아오면 다음 단계로 넘어갑니다.</string>
    <string name="step3_title">3/3  페어링 코드 입력</string>
    <string name="step3_guide">\'페어링 코드로 기기 페어링\'을 눌러 6자리 코드가 보이게 한 뒤, 화면 위쪽 알림창을 내려 \'코드 입력\'에 그 숫자를 적으세요.\n\n끝나면 무선 디버깅은 자동으로 꺼집니다.</string>
    <string name="step_open_wireless">무선 디버깅 열기</string>

    <string name="channel_name">설정 진행</string>
    <string name="notif_pair_title">셔터음 설정</string>
    <string name="notif_pair_waiting">무선 디버깅을 켜고 \'페어링 코드로 기기 페어링\' 화면을 열어 주세요.</string>
    <string name="notif_pair_ready">페어링 화면을 찾았습니다. 화면의 6자리 코드를 아래에 입력하세요.</string>
    <string name="notif_input_action">코드 입력</string>
    <string name="notif_input_hint">6자리 코드</string>
    <string name="notif_bad_code">6자리 숫자를 입력해 주세요.</string>
    <string name="notif_no_pairing_screen">\'페어링 코드로 기기 페어링\' 화면이 열려 있어야 합니다.</string>
    <string name="notif_working_title">설정 중</string>
    <string name="notif_pairing">페어링 중…</string>
    <string name="notif_connecting">연결 중…</string>
    <string name="notif_applying">적용 중…</string>

    <string name="result_done">완료: 셔터음이 꺼졌습니다. (소리 모드가 진동/무음일 때 동작)</string>
    <string name="result_restored">셔터음이 복원되었습니다.</string>
    <string name="result_failed">실패: %1$s</string>
    <string name="err_need_setup">먼저 1회 설정이 필요합니다.</string>
    <string name="err_connect">무선 디버깅에 연결하지 못했습니다. Wi-Fi 연결을 확인하세요.</string>
    <string name="err_verify">설정을 적용했지만 값이 바뀌지 않았습니다.</string>

    <string name="notes">• 시스템 소리 모드가 진동/무음일 때 동작합니다.\n• 재부팅 후 풀리면 자동으로 다시 적용합니다.\n• Wi-Fi에 연결되어 있어야 합니다.</string>
</resources>
