<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kimkinam.camerashit.helper"
    android:versionCode="1"
    android:versionName="0.1" >

    <uses-sdk
        android:minSdkVersion="22"
        android:targetSdkVersion="22" />

    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:label="CameraShit Helper" >

        <!--
            본 앱만 호출할 수 있게 본 앱이 정의한 signature 권한을 요구한다(같은 서명 키가 아니면 거부).
            부팅 신호는 시스템이 보내므로 이 권한과 무관하게 전달된다.
        -->
        <receiver
            android:name="com.kimkinam.camerashit.helper.ControlReceiver"
            android:exported="true"
            android:permission="com.kimkinam.camerashit.permission.CONTROL_HELPER" >
            <intent-filter>
                <action android:name="com.kimkinam.camerashit.helper.SET" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>