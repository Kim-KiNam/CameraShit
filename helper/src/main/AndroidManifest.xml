<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:label="CameraShit Helper">

        <!--
            본 앱만 호출할 수 있게 본 앱이 정의한 signature 권한을 요구한다(같은 서명 키가 아니면 거부).
            부팅 신호는 시스템이 보내므로 이 권한과 무관하게 전달된다.
        -->
        <receiver
            android:name=".ControlReceiver"
            android:exported="true"
            android:permission="com.kimkinam.camerashit.permission.CONTROL_HELPER">
            <intent-filter>
                <action android:name="com.kimkinam.camerashit.helper.SET" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
